{
  "name": "seshlehem-open-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,blue \"vite\" \"wrangler dev --local --port 8787\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev --local --port 8787",
    "db:migrate": "wrangler d1 migrations apply seshlehem-open-db --local",
    "db:seed": "wrangler d1 execute seshlehem-open-db --local --file=./seed/moray.sql",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "build": "pnpm typecheck && pnpm build:web && pnpm build:worker",
    "build:web": "vite build --configLoader runner",
    "build:worker": "vite build --config vite.worker.config.ts --configLoader runner && wrangler deploy dist-worker/index.js --dry-run --no-bundle"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.87.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250830.0",
    "@eslint/js": "^9.34.0",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.33.2"
  }
}
