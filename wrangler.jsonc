{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seshlehem-open-app",
  "main": "worker/index.ts",
  "compatibility_date": "2025-08-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
